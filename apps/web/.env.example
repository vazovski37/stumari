# Copy to .env.local (gitignored) and fill in. Reference: docs/architecture/configuration.md
# Never commit real values. Secrets stay server-side: only NEXT_PUBLIC_* reaches the browser.

# localnet | devnet | mainnet-beta
STUMARI_CLUSTER=devnet
# Server-only RPC. Locally the public devnet endpoint is fine; on Vercel use a Helius/Triton devnet URL.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Fixed program id (ADR-0008); must equal onchain/artifacts/program-id.txt
STUMARI_PROGRAM_ID=6Y17gFD9dWPJF6GtpzABJZY7Pk8j5CLh268zZyW5U6nf
# Mock USDC mint created by scripts/bootstrap.ts (devnet)
STUMARI_MINT=
# Fee payer, rent payer and quote signer: base58 of the 64-byte secret (Phantom export)
# or the JSON byte array written by solana-keygen, e.g. [12,34,...]
OPERATOR_SECRET_KEY=
# Arbiter stub; defaults to OPERATOR_SECRET_KEY
ADMIN_SECRET_KEY=
# Comma-separated wallets allowed into /admin
ADMIN_WALLETS=
# >= 32 random bytes as hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Bearer token for /api/cron/*
CRON_SECRET=
# Local SQLite file in development; libsql://<db>.turso.io in production (never file: on Vercel)
LIBSQL_URL=file:./.data/stumari.db
# Turso auth token (production)
LIBSQL_AUTH_TOKEN=
# Demo wallet + faucet (devnet only; forced off on mainnet-beta)
STUMARI_DEMO_MODE=true
# Absolute base URL for links, iCal feeds and SIWS host checks
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Per-booking cap during the pilot, in USDC base units (1500000000 = 1,500 USDC)
AMOUNT_CAP_MINOR=1500000000
# Optional: notify founders of new pilot applications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Test-only, set by scripts/e2e.ts for its own server: allow http loopback iCal imports (localnet only, never on Vercel; ADR-0017)
# ICAL_ALLOW_LOOPBACK=false
# Optional: Meta Pixel id (digits only, Events Manager -> Data sources) for Facebook/Instagram ad measurement.
# Unset = no cookie banner and no pixel. Set = the landing shows a consent banner and loads the pixel only after
# "Accept" (PageView + a Lead event on application submit). Inlined at build time: redeploy after changing it.
# In Events Manager turn OFF "Automatic advanced matching" so the pixel never reads form fields (privacy page says so).
NEXT_PUBLIC_META_PIXEL_ID=
